# Copy to .env and fill in to enable live venues. Leave unset for paper mode.

# Master switch. MUST be true to place real orders. Default paper-only.
TB_LIVE=false
TB_LOG_LEVEL=INFO
TB_LOOP_INTERVAL_S=2.0
TB_PAPER_STARTING_CASH=1000

# Strategies to run. Available: arbitrage, market_maker
TB_ENABLED_STRATEGIES=["arbitrage"]

# --- Cross-venue event mapping (so cross-venue arb can fire) ---
# Link the same real outcome across venues (native ids never match). Either a
# JSON file of link groups, or inline. Group: {"link_id","members":[{venue,market_id}]}.
TB_LINK_MAP_PATH=
TB_LINK_LINKS=[]

# --- Universe curation (which markets get tracked) ---
TB_UNIVERSE_MAX_PER_VENUE=100        # keep the top-N most-liquid markets per venue
TB_UNIVERSE_MIN_VOLUME=0             # drop markets below this 24h volume (raise for live)
TB_UNIVERSE_REFRESH_INTERVAL_MIN=10  # re-curate this often (0 disables)
TB_UNIVERSE_CATEGORIES=[]            # e.g. ["politics","sports"]; empty = all
TB_UNIVERSE_WATCHLIST=[]             # market_ids/tickers/event_ids; empty = all

# --- Market maker (when "market_maker" is enabled above) ---
TB_MM_MIN_SPREAD=0.02         # only quote when ask-bid >= this (covers fees + edge)
TB_MM_QUOTE_SIZE=10
TB_MM_MAX_INVENTORY=40        # size shrinks to 0 at this position, mean-reverting inventory
TB_MM_MAX_MARKETS=15          # quote the widest-spread N markets

# --- Risk limits (sane defaults in config.py; override here) ---
TB_RISK_MAX_POSITION_PER_MARKET=100
TB_RISK_MAX_NOTIONAL_PER_MARKET=50
TB_RISK_MAX_GROSS_NOTIONAL=500
TB_RISK_MAX_DAILY_LOSS=50
TB_RISK_MAX_ORDERS_PER_MIN=60

# --- Stop-loss / take-profit (fractions of entry price; 0 disables) ---
# Default OFF — turn on for directional exposure; arb legs hold to resolution.
TB_EXIT_ENABLED=false
TB_EXIT_STOP_LOSS_PCT=0.0      # e.g. 0.25 = close at -25% from entry
TB_EXIT_TAKE_PROFIT_PCT=0.0    # e.g. 0.50 = close at +50% from entry

# --- Persistence (positions/cash survive restart; needed before unattended live) ---
TB_PERSIST_ENABLED=false
TB_PERSIST_PATH=.tradingbot/state.db

# --- HTTP control API (for the LangGraph/external agent) ---
TB_API_ENABLED=false
TB_API_HOST=127.0.0.1
TB_API_PORT=8787
TB_API_TOKEN=                  # required when enabled; the agent sends it as a bearer token

# --- WebSocket streaming books (sub-second data; replaces REST polling) ---
# Polymarket market channel is public; Kalshi streaming needs Kalshi creds.
# Fail-safe: if the WS yields nothing the engine REST-falls-back automatically.
TB_STREAMING_ENABLED=false
TB_STREAMING_REST_FALLBACK_CAP=20
TB_STREAMING_LOOP_INTERVAL_S=0.25   # backstop-loop cadence when streaming
TB_STREAMING_EVENT_DRIVEN=true      # react the instant a market updates (~11ms) vs waiting on the loop
TB_STREAMING_REACT_DEBOUNCE_S=0.01  # coalesce bursts of updates into one evaluation

# --- Kalshi (RSA-signed API). Get from https://kalshi.com account settings ---
TB_KALSHI_API_KEY_ID=
TB_KALSHI_PRIVATE_KEY_PATH=
TB_KALSHI_BASE_URL=https://api.elections.kalshi.com

# --- Polymarket (wallet signing for CLOB) ---
TB_POLY_PRIVATE_KEY=
TB_POLY_FUNDER_ADDRESS=
TB_POLY_CLOB_URL=https://clob.polymarket.com

# --- Claude agent ("the brain"). Needs `pip install -e ".[agent]"`. ---
# api_key falls back to ANTHROPIC_API_KEY if left blank.
TB_ANTHROPIC_API_KEY=
TB_ANTHROPIC_MODEL=claude-opus-4-8
TB_ANTHROPIC_EFFORT=high
TB_ANTHROPIC_MAX_TOKENS=8000

# --- Telegram (chat with the agent from your phone) ---
# Get a token from @BotFather. allowed_chat_ids is a JSON list of integer chat
# IDs permitted to command the bot (empty = nobody, the safe default).
TB_TELEGRAM_BOT_TOKEN=
TB_TELEGRAM_ALLOWED_CHAT_IDS=[]

# --- Profit goals (set targets in $; 0 disables that target) ---
TB_GOAL_DAILY_TARGET=0
TB_GOAL_WEEKLY_TARGET=0
TB_GOAL_LOCK_GAINS=true               # pause trading once the daily target is hit
TB_GOAL_STATE_PATH=.tradingbot/goals.json

# --- Autopilot (autonomous reassess + Telegram briefings) ---
TB_AUTOPILOT_ENABLED=false
TB_AUTOPILOT_INTERVAL_MIN=30
TB_AUTOPILOT_BRIEFING=true
