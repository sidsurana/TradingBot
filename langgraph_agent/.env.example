# Copy to .env (LangGraph loads it). These configure the permanent agent.

# Your Anthropic key (the agent's model calls).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Which model the agent uses. claude-opus-4-8 = most capable;
# claude-haiku-4-5 = cheap for frequent check-ins (cuts your bill).
LANGGRAPH_MODEL=claude-opus-4-8

# Where the bot's control API is, and the shared token (must equal the bot's
# TB_API_TOKEN). For a bot on your machine + agent in LangGraph Cloud, expose the
# API via a tunnel (ngrok/cloudflared) and put the public URL here.
TRADINGBOT_API_URL=http://127.0.0.1:8787
TRADINGBOT_API_TOKEN=choose-a-long-random-string

# --- Telegram bridge (telegram_bridge.py) ---
# From @BotFather. allowed = JSON list (or comma-separated) of permitted chat IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=[]
