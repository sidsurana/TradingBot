# Copy to .env (LangGraph loads it). These configure the permanent agent.

# Your Anthropic key (the agent's model calls).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Which model the agent uses. claude-opus-4-8 = most capable;
# claude-haiku-4-5 = cheap for frequent check-ins (cuts your bill).
LANGGRAPH_MODEL=claude-opus-4-8

# Where the bot's control API is, and the shared token (must equal the bot's
# TB_API_TOKEN). For a bot on your machine + agent in LangGraph Cloud, expose the
# API via a tunnel (ngrok/cloudflared) and put the public URL here.
TRADINGBOT_API_URL=http://127.0.0.1:8787
TRADINGBOT_API_TOKEN=choose-a-long-random-string

# --- Telegram bridge (telegram_bridge.py) ---
# From @BotFather. allowed = JSON list (or comma-separated) of permitted chat IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=[]

# --- Daily scheduled reports (telegram_bridge.py) ---
# Morning market brief: deterministic snapshot (SPY/QQQ/gold/oil via Yahoo,
# BTC via Coinbase) — last price, 1-day % change, above/below the 20-day
# average. No LLM call. Local time HH:MM; empty string disables it.
MORNING_BRIEF_TIME=08:00
# Night performance report: equity/cash/session PnL from the control API,
# the equity-curve summary from pnl_history.csv, and open positions. Local
# time HH:MM; empty string disables it. While set, the old rolling-24h P&L
# report is suppressed (hourly CSV snapshots continue either way).
EVENING_REPORT_TIME=20:00
# IANA timezone for the report times, e.g. America/New_York or Asia/Kolkata.
# SET THIS EXPLICITLY. If empty it falls back to the machine's local timezone,
# but a launchd/systemd service often does NOT inherit your shell's timezone
# (it can resolve to UTC), so the brief fires hours off. Pinning the zone here
# fixes that and auto-handles DST (EST<->EDT).
REPORT_TZ=America/New_York
